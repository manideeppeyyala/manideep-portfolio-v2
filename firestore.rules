rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Site content: anyone can read (it's your public portfolio),
    // only a signed-in admin (you) can write.
    match /site/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Feedback: anyone can submit (create), nobody but the admin can edit,
    // and only the admin can delete (moderation). Public read so the site
    // can show testimonials + average rating.
    match /feedback/{docId} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasAll(['rating', 'message', 'createdAt'])
                    && request.resource.data.rating is int
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5;
      allow update: if false;
      allow delete: if request.auth != null;
    }

    // Page view counter: low-sensitivity, anyone can increment it.
    match /stats/{docId} {
      allow read: if true;
      allow write: if true;
    }
  }
}
